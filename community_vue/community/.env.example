# ============================================================
# 前端环境变量模板
# 依据 .env.development / .env.production / .env.staging 整理。
# 若依 Vue 项目通过 vue-cli 按环境读取对应 .env.* 文件。
# ============================================================

# 页面标题
VUE_APP_TITLE=智慧社区物业管理平台

# 开发环境配置
ENV='development'

# 后端 API 前缀（开发 / 生产 / 测试 分别对应 /dev-api、/prod-api、/stage-api）
VUE_APP_BASE_API='/dev-api'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES=true
